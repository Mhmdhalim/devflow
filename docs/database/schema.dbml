Table users {
  id uuid [pk, not null]
  email varchar(320) [not null, unique]
  full_name varchar(120) [not null]
  is_active boolean [not null, default: true]
  hashed_password varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table organizations {
  id uuid [pk, not null]
  name varchar(120) [not null]
  slug varchar(120) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table memberships {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  organization_id uuid [not null, ref: > organizations.id]
  role varchar(20) [not null, default: 'member']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    organization_id
    (user_id, organization_id) [unique]
  }

  Note: 'role is constrained to owner, admin, or member'
}

Table projects {
  id uuid [pk, not null]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(120) [not null]
  key varchar(20) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id
    (organization_id, key) [unique]
  }
}

Table issues {
  id uuid [pk, not null]
  project_id uuid [not null, ref: > projects.id]
  number integer [not null]
  title varchar(200) [not null]
  description text
  status varchar(20) [not null, default: 'todo']
  priority varchar(20) [not null, default: 'medium']
  reporter_id uuid [not null, ref: > users.id]
  assignee_id uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
    status
    reporter_id
    assignee_id
    (project_id, number) [unique]
  }

  Note: 'number must be positive; status is constrained to todo, in_progress, or done; priority is constrained to low, medium, or high'
}

Table comments {
  id uuid [pk, not null]
  issue_id uuid [not null, ref: > issues.id]
  author_id uuid [not null, ref: > users.id]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    issue_id
    author_id
  }
}

Table labels {
  id uuid [pk, not null]
  project_id uuid [not null, ref: > projects.id]
  name varchar(50) [not null]
  color varchar(7)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
    (project_id, name) [unique]
  }
}

Table issue_labels {
  issue_id uuid [not null, ref: > issues.id]
  label_id uuid [not null, ref: > labels.id]

  indexes {
    (issue_id, label_id) [pk]
  }

  Note: 'Both foreign keys use ON DELETE CASCADE in the SQLAlchemy model.'
}