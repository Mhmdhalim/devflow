Table users {
  id bigint [pk, increment]
  email varchar [not null, unique]
  password_hash varchar [not null]
  display_name varchar [not null]
  status varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token_hash varchar [not null, unique]
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null]
}

Table organizations {
  id bigint [pk, increment]
  owner_id bigint [not null, ref: > users.id]
  name varchar [not null]
  slug varchar [not null, unique]
  created_at timestamp [not null]
}

Table organization_members {
  id bigint [pk, increment]
  organization_id bigint [not null, ref: > organizations.id]
  user_id bigint [not null, ref: > users.id]
  role varchar [not null]
  joined_at timestamp [not null]
  indexes {
    (organization_id, user_id) [unique]
  }
}

Table projects {
  id bigint [pk, increment]
  organization_id bigint [not null, ref: > organizations.id]
  name varchar [not null]
  key varchar [not null]
  description text
  status varchar [not null]
  created_at timestamp [not null]
  indexes {
    (organization_id, key) [unique]
  }
}

Table project_members {
  id bigint [pk, increment]
  project_id bigint [not null, ref: > projects.id]
  user_id bigint [not null, ref: > users.id]
  role varchar [not null]
  indexes {
    (project_id, user_id) [unique]
  }
}

Table labels {
  id bigint [pk, increment]
  project_id bigint [not null, ref: > projects.id]
  name varchar [not null]
  color varchar [not null]
  indexes {
    (project_id, name) [unique]
  }
}

Table issues {
  id bigint [pk, increment]
  project_id bigint [not null, ref: > projects.id]
  reporter_id bigint [not null, ref: > users.id]
  title varchar [not null]
  description text
  type varchar [not null]
  status varchar [not null]
  priority varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table issue_assignees {
  issue_id bigint [not null, ref: > issues.id]
  user_id bigint [not null, ref: > users.id]
  indexes {
    (issue_id, user_id) [pk]
  }
}

Table issue_labels {
  issue_id bigint [not null, ref: > issues.id]
  label_id bigint [not null, ref: > labels.id]
  indexes {
    (issue_id, label_id) [pk]
  }
}

Table comments {
  id bigint [pk, increment]
  issue_id bigint [not null, ref: > issues.id]
  author_id bigint [not null, ref: > users.id]
  body text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  type varchar [not null]
  payload jsonb
  read_at timestamp
  created_at timestamp [not null]
}

Table audit_logs {
  id bigint [pk, increment]
  actor_id bigint [ref: > users.id]
  entity_type varchar [not null]
  entity_id bigint [not null]
  action varchar [not null]
  metadata jsonb
  created_at timestamp [not null]
}

Table attachments {
  id bigint [pk, increment]
  issue_id bigint [not null, ref: > issues.id]
  uploaded_by bigint [not null, ref: > users.id]
  storage_key varchar [not null, unique]
  filename varchar [not null]
  content_type varchar [not null]
  size_bytes bigint [not null]
}